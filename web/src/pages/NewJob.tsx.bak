import { useState } from 'react';
import { Link } from 'react-router-dom';
import { api } from '../api';

type PlanMilestone = { title: string; amount: number; criteria: string };
type Plan = { title: string; milestones: PlanMilestone[] };

export default function NewJob() {
  const [description, setDescription] = useState('');
  const [total, setTotal] = useState('100');
  const [workerEmail, setWorkerEmail] = useState('worker@kazi.demo');
  const [plan, setPlan] = useState<Plan | null>(null);
  const [busy, setBusy] = useState('');
  const [error, setError] = useState('');

  async function preview() {
    setBusy('preview');
    setError('');
    try {
      const d = await api<{ plan: Plan }>('/api/jobs/scope', {
        body: { description, totalAmount: Number(total) },
      });
      setPlan(d.plan);
    } catch (e) {
      setError((e as Error).message);
    } finally {
      setBusy('');
    }
  }

  async function createAndFund() {
    if (!plan) return;
    setBusy('create');
    setError('');
    try {
      const { job } = await api<{ job: { id: string } }>('/api/jobs', {
        body: { title: plan.title, description, workerEmail, milestones: plan.milestones },
      });
      const { approveUrl } = await api<{ approveUrl: string }>(`/api/jobs/${job.id}/fund`, { method: 'POST' });
      window.location.href = approveUrl;
    } catch (e) {
      setError((e as Error).message);
      setBusy('');
    }
  }

  return (
    <div className="max-w-3xl mx-auto p-4 space-y-4">
      <Link className="text-sm text-white/70 hover:text-brand-500 no-underline" to="/">← My jobs</Link>
      <h1 className="text-2xl font-bold">New job</h1>

      <div className="bg-surface border border-white/10 rounded-xl shadow p-4 space-y-3">
        <label className="block text-sm font-medium">What work needs doing?</label>
        <textarea
          className="w-full border rounded px-3 py-2 h-28"
          placeholder="Example: Build 20 wooden school desks for a primary school in Kiambu. The carpenter supplies the timber and delivers them."
          value={description}
          onChange={(e) => { setDescription(e.target.value); setPlan(null); }}
        />
        <p className={`text-xs ${description.trim().length >= 10 ? 'text-brand-500' : 'text-white/60'}`}>
          {description.trim().length >= 10
            ? 'Looks good'
            : `Describe the job in at least 10 characters (${description.trim().length}/10)`}
        </p>
        <div className="grid grid-cols-2 gap-3">
          <div>
            <label className="block text-sm font-medium">Total budget (USD, max 5000)</label>
            <input
              className="w-full border rounded px-3 py-2"
              type="number"
              min="1"
              value={total}
              onChange={(e) => { setTotal(e.target.value); setPlan(null); }}
            />
          </div>
          <div>
            <label className="block text-sm font-medium">Worker email</label>
            <input
              className="w-full border rounded px-3 py-2"
              value={workerEmail}
              onChange={(e) => setWorkerEmail(e.target.value)}
            />
          </div>
        </div>
        <button
          className="bg-brand-500 text-ink font-semibold hover:bg-brand-600 rounded-lg px-4 py-2 disabled:bg-white/10 disabled:text-white/40 disabled:cursor-not-allowed disabled:hover:bg-white/10"
          disabled={busy !== '' || description.trim().length < 10 || !(Number(total) > 0)}
          onClick={preview}
        >
          {busy === 'preview' ? 'Planning…' : plan ? 'Regenerate plan' : 'Preview payment plan'}
        </button>
      </div>

      {error && <p className="text-red-600">{error}</p>}

      {plan && (
        <div className="bg-surface border border-white/10 rounded-xl shadow p-4 space-y-3">
          <h2 className="font-semibold">{plan.title}</h2>
          <p className="text-sm text-white/70">
            Each payment is released only after you approve the worker's photo proof for that step.
          </p>
          <ol className="space-y-3">
            {plan.milestones.map((m, i) => (
              <li key={i} className="border rounded p-3">
                <div className="flex justify-between font-medium">
                  <span>{i + 1}. {m.title}</span>
                  <span>{m.amount} USD</span>
                </div>
                <p className="text-sm text-white/70 mt-1">Proof needed: {m.criteria}</p>
              </li>
            ))}
          </ol>
          <button
            className="bg-brand-500 text-ink font-semibold hover:bg-brand-600 rounded-lg px-4 py-2 disabled:bg-white/10 disabled:text-white/40 disabled:cursor-not-allowed disabled:hover:bg-white/10"
            disabled={busy !== ''}
            onClick={createAndFund}
          >
            {busy === 'create' ? 'Creating…' : 'Create job and pay with PayPal'}
          </button>
        </div>
      )}
    </div>
  );
}
